# Copia este archivo como .env.local y completa los valores.
# Se obtienen en el dashboard de Supabase: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta. NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Dominio sintético usado para transformar la cédula del conductor en un
# email interno para Supabase Auth (ej. 1012345678@cootranszipa.invalid).
# ".invalid" es un TLD reservado por RFC 2606 que nunca existirá en internet.
NEXT_PUBLIC_DOMINIO_CEDULA=cootranszipa.invalid
